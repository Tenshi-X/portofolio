---
// src/components/SkillLogo.astro
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  icon: string;
}
const { name, icon } = Astro.props;
---
<div class="tech-item">
    <Icon name={icon} class="tech-icon" />
    <p>{name}</p>
</div>

<style>
    .tech-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 12px;
    }
    
    .tech-item:hover {
        transform: translateY(-5px) scale(1.05);
        background: rgba(255, 255, 255, 0.03);
    }
    
    .tech-icon {
        width: 48px;
        height: 48px;
        color: var(--text-main);
        transition: all 0.3s ease;
    }
    
    .tech-item:hover .tech-icon {
        color: var(--accent-primary);
        filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.5));
        transform: scale(1.1);
    }
    
    p {
        margin: 0;
        font-weight: 500;
        font-size: 1rem;
        color: var(--text-muted);
        text-align: center;
        transition: color 0.3s ease;
    }

    .tech-item:hover p {
        color: var(--text-main);
    }
</style>