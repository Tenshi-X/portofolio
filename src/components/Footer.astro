---
// src/components/Footer.astro
const discordUser = "_tenshix";
const currentYear = new Date().getFullYear();
---
<footer id="kontak" class="footer">
    <div class="container">
        <h2>Hubungi Saya</h2>
        <p>Anda dapat menemukan saya di platform berikut:</p>
        <div class="contact-links">
            <a href={`https://github.com/Tenshi-X`} target="_blank">GitHub: Tenshi-X</a>
            <span>Discord: {discordUser}</span>
        </div>
        <div class="copyright">
            &copy; {currentYear} Tenshi-X. Dibuat dengan Astro.
        </div>
    </div>
</footer>