---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import SkillLogo from '../components/SkillLogo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { skillCategories } from '../data/skills';
/* Define types inline or import if available. For now, strict typing is good. */
interface Skill {
    name: string;
    icon: string;
}
interface SkillCategory {
    title: string;
    skills: Skill[];
}
import { projects } from '../data/projects';

const webProjects = projects.filter(p => p.category === 'Web');
const mobileProjects = projects.filter(p => p.category === 'Mobile');
---
<Layout title="Seva Giantama Farel | Software Engineer">
	
	<!-- Hero Section -->
	<section class="hero">
		<div class="container hero-content">
			<div class="hero-text reveal">
				<h2 class="subtitle">Hello, I'm</h2>
				<h1>Seva <br /><span class="text-gradient">Giantama Farel</span></h1>
				<p>
					A data-driven <strong>Software Engineer</strong> specializing in building exceptional digital experiences. 
					Currently focused on building accessible, human-centered products.
				</p>
				<div class="cta-group">
					<a href="#projects" class="btn btn-primary">View Work</a>
					<a href="#contact" class="btn btn-secondary">Contact Me</a>
				</div>
			</div>
			<!-- Optional: You can put a abstract 3D element or a stylized profile image here -->
			<div class="hero-visual reveal delay-200">
				<img src="/profile-pic.png" alt="Seva Giantama Farel" class="profile-pic">
			</div>
		</div>
	</section>

	<!-- About Section -->
	<section id="about" class="about">
		<div class="container">
			<h2 class="section-title reveal">About <span class="text-gradient">Me</span></h2>
			<div class="grid-2 reveal delay-100">
				<div class="about-text">
					<p>
						I am a passionate developer with a knack for solving complex problems. 
						My journey in tech has been driven by a curiosity to understand how things work 
						and a desire to create tools that make life easier.
					</p>
					<p>
						I specialize in <strong>Full Stack Development</strong>, with deep expertise in 
						layout engineering, performance optimization, and scalable backend architecture.
					</p>
				</div>
				<div class="about-stats">
					<div class="stat-item">
						<span class="stat-number text-gradient">3+</span>
						<span class="stat-label">Years Experience</span>
					</div>
					<div class="stat-item">
						<span class="stat-number text-gradient">20+</span>
						<span class="stat-label">Projects Completed</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Skills Section -->
	<section id="skills" class="skills">
		<div class="container">
			<h2 class="section-title reveal">Tech <span class="text-gradient">Stack</span></h2>
			
			{(skillCategories as SkillCategory[]).map((category, index) => (
				<div class="skill-category reveal delay-100">
					<h3 class="skill-category-title">{category.title}</h3>
					<div class="skill-grid">
						{category.skills.map(skill => (
							<SkillLogo name={skill.name} icon={skill.icon} />
						))}
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- Experience Section (New) -->
	<section id="experience" class="experience">
		<div class="container">
			<h2 class="section-title reveal">Experience</h2>
			<h3 class="experience-category-title reveal delay-100">Work Experience</h3>
			<div class="timeline reveal delay-100">
				<div class="timeline-item">
					<div class="timeline-date">Jul 2024 - Present</div>
					<div class="timeline-content">
						<h3>Software Engineer (Freelance)</h3>
						<h4>Cont Solutions Indonesia - Sleman, Yogyakarta</h4>
						<p>Technology and creative media company specializing in web and application development.</p>
						<ul class="timeline-list">
							<li>Contributed as an <strong>Android Developer</strong> using Kotlin (Distance sensor integration for real-time monitoring).</li>
							<li>Worked as a <strong>Backend Developer</strong> using Express.js, building RESTful APIs and server-side logic.</li>
							<li>Role as <strong>Frontend Developer</strong> using React.js for responsive UI and backend integration.</li>
						</ul>
					</div>
				</div>
				<div class="timeline-item">
					<div class="timeline-date">Feb 2024 - Jun 2024</div>
					<div class="timeline-content">
						<h3>Android Developer</h3>
						<h4>Bangkit Academy - Indonesia</h4>
						<p>Career readiness program supported by Google, GoTo, Tokopedia, and Traveloka.</p>
						<ul class="timeline-list">
							<li>Developed "BacaLagi", an Android app for selling used books (Capstone Project).</li>
							<li>Built using <strong>Kotlin</strong>, XML, Firebase, and Retrofit.</li>
							<li>Integrated <strong>TensorFlow Lite</strong> (TFLite) model for book price prediction based on cover images.</li>
						</ul>
					</div>
				</div>
			</div>

			<h3 class="experience-category-title reveal delay-200" style="margin-top: 3rem;">Organizational Experience</h3>
			<div class="timeline reveal delay-200">
				<!-- Organizational Experience -->
				<div class="timeline-item">
					<div class="timeline-date">Jun 2023 - Sep 2024</div>
					<div class="timeline-content">
						<h3>Chairman</h3>
						<h4>Information Technology Club - UPN "Veteran" Yogyakarta</h4>
						<p>Led a study group focused on developing human resources in informatics.</p>
						<ul class="timeline-list">
							<li>Coordinated 4 divisions: Web, Mobile, UI/UX, and PM with 50 active members.</li>
							<li>Facilitated weekly training sessions based on tailored curricula.</li>
							<li>Led execution of internal projects and collaborative competitions.</li>
						</ul>
					</div>
				</div>

				<div class="timeline-item">
					<div class="timeline-date">Feb 2024 - Feb 2025</div>
					<div class="timeline-content">
						<h3>Head of Dept. Advokasi & Kesejahteraan</h3>
						<h4>Himpunan Mahasiswa Program Studi Informatika - UPN "Veteran" Yogyakarta</h4>
						<ul class="timeline-list">
							<li>Solved student issues related to tuition and academics through policy coordination.</li>
							<li>Initiated a student feedback system to identify and resolve recurring academic issues.</li>
						</ul>
					</div>
				</div>
			</div>

<style>
	/* Skill Categories */
	.skill-category {
		margin-bottom: 3rem;
	}
	.skill-category-title {
		text-align: center;
		font-size: 1.25rem;
		color: var(--text-muted);
		margin-bottom: 1.5rem;
		font-weight: 500;
	}

/* Additional local styles for the list */
.timeline-list {
	margin-top: 0.5rem;
	padding-left: 1.2rem;
	color: var(--text-muted);
	font-size: 0.95rem;
}
.timeline-list li {
	margin-bottom: 0.25rem;
}
</style>
		</div>
	</section>

	<!-- Projects Section -->
	<section id="projects" class="projects">
		<div class="container">
			<h2 class="section-title reveal">Featured <span class="text-gradient">Work</span></h2>
			
			<div class="project-category">
				<h3>Web Development</h3>
				<div class="project-grid reveal delay-100">
					{webProjects.map(project => (
						<ProjectCard project={project} />
					))}
				</div>
			</div>

			<div class="project-category" style="margin-top: 3rem;">
				<h3>Mobile Applications</h3>
				<div class="project-grid reveal delay-100">
					{mobileProjects.map(project => (
						<ProjectCard project={project} />
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Contact Section -->
	<section id="contact" class="contact">
		<div class="container reveal">
			<div class="contact-box">
				<h2>Let's Work Together</h2>
				<p>Have a project in mind? I'm always open to discussing new opportunities.</p>
				<a href="mailto:sevagiantama@example.com" class="btn btn-primary">Say Hello</a>
			</div>
		</div>
	</section>

</Layout>

<style>
	/* Local Page Styles */
	.hero {
		padding: 4rem 0;
		/* Removing fixed min-height to prevent large gaps on tall screens */
		/* min-height: 80vh; */ 
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-content {
		display: flex;
		flex-direction: row; /* Explicitly set row */
		align-items: center;
		justify-content: space-between;
		gap: 4rem;
		width: 100%;
	}

	.hero-text {
		flex: 1;
		text-align: left; /* Ensure left alignment */
		max-width: 600px;
	}

	.hero-visual {
		flex: 1;
		display: flex;
		justify-content: flex-end; /* Align image to the right */
	}

	.subtitle {
		font-size: 1.5rem;
		color: var(--accent-primary);
		margin-bottom: 0.5rem;
		font-weight: 500;
	}
	
	.cta-group {
		display: flex;
		gap: 1rem;
		margin-top: 2rem;
		justify-content: flex-start; /* Left align buttons */
	}
	
	.section-title {
		font-size: 2.5rem;
		margin-bottom: 2.5rem;
		text-align: center;
	}
	
	/* About Stats */
	.about-stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}
	.stat-item {
		background: var(--bg-card);
		padding: 1.5rem;
		border-radius: 12px;
		border: 1px solid var(--border-light);
		text-align: center;
	}
	.stat-number {
		display: block;
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}
	.stat-label {
		color: var(--text-muted);
		font-size: 0.9rem;
	}
	
	/* Timeline */
	.timeline {
		position: relative;
		border-left: 2px solid var(--border-light);
		margin-left: 1rem;
		padding-left: 2rem;
	}
	.timeline-item {
		margin-bottom: 2.5rem;
		position: relative;
	}
	.timeline-item::before {
		content: '';
		position: absolute;
		left: -2.6rem;
		top: 0.5rem;
		width: 1rem;
		height: 1rem;
		background: var(--accent-primary);
		border-radius: 50%;
		border: 4px solid var(--bg-main);
	}
	.timeline-date {
		color: var(--accent-primary);
		font-weight: 500;
		margin-bottom: 0.5rem;
	}
	
	/* Contact Box */
	.contact-box {
		background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.1));
		border: 1px solid var(--border-light);
		border-radius: 24px;
		padding: 4rem 2rem;
		text-align: center;
	}

	.experience-category-title {
		font-size: 1.5rem;
		color: var(--accent-primary);
		margin-bottom: 1.5rem;
		margin-left: 1rem; /* Align with timeline border */
		font-weight: 600;
	}
	
	/* Responsive Adjustments */
	@media (max-width: 968px) {
		.hero-content {
			flex-direction: column-reverse;
			text-align: center;
			gap: 3rem;
		}
		
		.hero-text {
			margin: 0 auto;
			text-align: center;
		}

        .hero-visual {
            justify-content: center;
        }
		
		.cta-group {
			justify-content: center;
		}
		
		.section-title {
			font-size: 2rem;
		}
	}
</style>